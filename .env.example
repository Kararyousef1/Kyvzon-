# Public frontend configuration only.
# Never put service-role keys or provider API keys in VITE_* variables.
# Copy this file to an untracked .env.local and fill values locally.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

VITE_APP_NAME=Kyvzon Platform
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Server-side secrets belong in Supabase Edge Function secrets, never in VITE_*:
# APP_ORIGIN — REQUIRED in production. Comma-separated allowlist of exact origins
#   allowed to call Admin Edge Functions (CORS). If unset/unmatched, cross-origin
#   requests are denied (no wildcard '*' is ever returned with credentials).
#   Example: APP_ORIGIN=https://app.kyvzon.example,https://admin.kyvzon.example
# APP_ORIGIN=https://your-production-origin.example
# SUPABASE_SERVICE_ROLE_KEY=...
# OPENROUTER_API_KEY=...
# GROQ_API_KEY=...
# ADMS_SECRET=...
